{
  "name": "to_rename",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "husky install",
    "serve": "./scripts/env-scripts/serve-with-env.sh $npm_config_env",
    "serve:development": "npm run serve --env=development",
    "serve:staging": "npm run serve --env=staging",
    "serve:production": "npm run serve --env=production",
    "build": "./scripts/env-scripts/build-with-env.sh $npm_config_env",
    "build:staging": "npm run build --env=staging",
    "build:production": "npm run build --env=production",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "start-server": "npx http-server dist/frontend/browser -p 4200",
    "e2e:ui": "./scripts/env-scripts/e2e-ui-with-env.sh $npm_config_env",
    "e2e:ui:staging": "npm run e2e:ui --env=staging",
    "e2e:ui:production": "npm run e2e:ui --env=production",
    "e2e:ci": "./scripts/env-scripts/e2e-ci-with-env.sh $npm_config_env",
    "e2e:ci:staging": "npm run e2e:ci --env=staging",
    "e2e:ci:production": "npm run e2e:ci --env=production",
    "lint": "npx ng lint",
    "prettier": "npx prettier --write .",
    "doc": "node -e \"require('os').platform() === 'win32' ? require('child_process').execSync('start http://127.0.0.1:8080') : require('child_process').execSync('open http://127.0.0.1:8080')\" && compodoc -p tsconfig.doc.json -s",
    "cap:config:dev:ios": "cp capacitor.config.development.ios.ts capacitor.config.ts",
    "cap:config:dev:android": "cp capacitor.config.development.android.ts capacitor.config.ts",
    "cap:config:staging": "cp capacitor.config.staging.ts capacitor.config.ts",
    "cap:config:production": "cp capacitor.config.production.ts capacitor.config.ts",
    "android:tunnel": "~/Library/Android/sdk/platform-tools/adb reverse tcp:4200 tcp:4200",
    "serve:development:android": "npx ng serve --configuration=development-android --host=0.0.0.0 --port=4200",
    "build:development:android": "npx ng build --configuration=development-android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/ios": "^8.0.1",
    "@capawesome/capacitor-badge": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.3.1",
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@stomp/ng2-stompjs": "^8.0.0",
    "@stomp/stompjs": "^7.1.1",
    "@types/leaflet": "^1.9.16",
    "@typescript-eslint/utils": "^8.56.0",
    "firebase": "^10.14.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "parse5": "^6.0.1",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.5.2",
    "tslib": "^2.3.0",
    "wscat": "^6.1.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.5",
    "@angular/cli": "^18.2.5",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/assets": "^3.0.5",
    "@compodoc/compodoc": "^1.1.32",
    "@cypress/angular": "^3.0.0",
    "@cypress/schematic": "^2.5.2",
    "@types/jest": "^29.5.14",
    "angular-eslint": "18.4.1",
    "cypress": "^14.0.3",
    "eslint": "^9.15.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.1",
    "json-server": "^1.0.0-beta.3",
    "start-server-and-test": "^2.0.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.15.0",
    "wait-on": "^8.0.1"
  }
}
